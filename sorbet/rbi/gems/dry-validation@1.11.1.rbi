  #   message_set.filter(:base?)
  #
  # @param [Array<Symbol>] predicates
  #
  # @return [MessageSet]
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/message_set.rb:75
  def filter(*predicates); end

  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/message_set.rb:83
  def freeze; end

  # Configured locale
  #
  # @return [Symbol]
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/message_set.rb:23
  def locale; end

  # Return the source set of messages used to produce final evaluated messages
  #
  # @return [Array<Message, Message::Localized, Schema::Message>]
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/message_set.rb:16
  def source_messages; end

  # Return a new message set using updated options
  #
  # @return [MessageSet]
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/message_set.rb:37
  def with(other, new_options = T.unsafe(nil)); end
end

# pkg:gem/dry-validation#lib/dry/validation/messages/resolver.rb:5
module Dry::Validation::Messages; end

# pkg:gem/dry-validation#lib/dry/validation/messages/resolver.rb:6
Dry::Validation::Messages::FULL_MESSAGE_WHITESPACE = T.let(T.unsafe(nil), Hash)

# Resolve translated messages from failure arguments
#
# @api public
#
# pkg:gem/dry-validation#lib/dry/validation/messages/resolver.rb:11
class Dry::Validation::Messages::Resolver
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/messages/resolver.rb:18
  def initialize(messages); end

  # pkg:gem/dry-validation#lib/dry/validation/messages/resolver.rb:52
  def [](message:, tokens:, path:, meta: T.unsafe(nil)); end

  # Resolve Message object from provided args and path
  #
  # This is used internally by contracts when rules are applied
  # If message argument is a Hash, then it MUST have a :text key,
  # which value will be used as the message value
  #
  # @return [Message, Message::Localized]
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/messages/resolver.rb:31
  def call(message:, tokens:, path:, meta: T.unsafe(nil)); end

  # Resolve a message
  #
  # @return [String]
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/messages/resolver.rb:62
  def message(rule, path:, tokens: T.unsafe(nil), locale: T.unsafe(nil), full: T.unsafe(nil)); end

  # @!attribute [r] messages
  #   @return [Messages::I18n, Messages::YAML] messages backend
  #   @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/messages/resolver.rb:15
  def messages; end

  private

  # pkg:gem/dry-validation#lib/dry/validation/messages/resolver.rb:102
  def key_text(path:, locale: T.unsafe(nil)); end

  # pkg:gem/dry-validation#lib/dry/validation/messages/resolver.rb:94
  def message_text(text, path:, locale: T.unsafe(nil), full: T.unsafe(nil)); end

  # pkg:gem/dry-validation#lib/dry/validation/messages/resolver.rb:115
  def parse_token(token); end

  # pkg:gem/dry-validation#lib/dry/validation/messages/resolver.rb:111
  def parse_tokens(tokens); end
end

# Error raised when a localized message was not found
#
# pkg:gem/dry-validation#lib/dry/validation/constants.rb:30
class Dry::Validation::MissingMessageError < ::StandardError; end

# Root path is used for base errors in hash representation of error messages
#
# pkg:gem/dry-validation#lib/dry/validation/constants.rb:13
Dry::Validation::ROOT_PATH = T.let(T.unsafe(nil), Array)

# Monad extension for contract results
#
# @example
#   Dry::Validation.load_extensions(:monads)
#
#   contract = Dry::Validation::Contract.build do
#     schema do
#       required(:name).filled(:string)
#     end
#   end
#
#   contract.call(name: nil).to_monad
#
# @api public
# Result objects are returned by contracts
#
# @api public
#
# pkg:gem/dry-validation#lib/dry/validation/result.rb:12
class Dry::Validation::Result
  include ::Dry::Core::Equalizer::Methods

  # Initialize a new result
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:50
  def initialize(schema_result, context, options); end

  # Read a value under provided key
  #
  # @param [Symbol] key
  #
  # @return [Object]
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:158
  def [](key); end

  # Add a new error for the provided key
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:146
  def add_error(error); end

  # Check if there's any error for the provided key
  #
  # This does not consider errors from the nested values
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:132
  def base_error?(key); end

  # Check if the result contains any base rule errors
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:123
  def base_rule_error?; end

  # Context that's shared between rules
  #
  # @return [Concurrent::Map]
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:31
  def context; end

  # Pattern matching
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:210
  def deconstruct; end

  # Pattern matching
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:203
  def deconstruct_keys(keys); end

  # Check if values include an error for the provided key
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:102
  def error?(key); end

  # Get error set
  #
  # @!macro errors-options
  #   @param [Hash] new_options
  #   @option new_options [Symbol] :locale Set locale for messages
  #   @option new_options [Boolean] :hints Enable/disable hints
  #   @option new_options [Boolean] :full Get messages that include key names
  #
  # @return [MessageSet]
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:77
  def errors(new_options = T.unsafe(nil)); end

  # Check if result is not successful
  #
  # @return [Bool]
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:95
  def failure?; end

  # Freeze result and its error set
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:194
  def freeze; end

  # Return a string representation
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:183
  def inspect; end

  # Check if a key was set
  #
  # @param [Symbol] key
  #
  # @return [Bool]
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:169
  def key?(key); end

  # Result options
  #
  # @return [Hash]
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:45
  def options; end

  # Check if the rules includes an error for the provided key
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:116
  def rule_error?(key); end

  # Check if the base schema (without rules) includes an error for the provided key
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:109
  def schema_error?(key); end

  # Result from contract's schema
  #
  # @return [Dry::Schema::Result]
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:38
  def schema_result; end

  # Check if result is successful
  #
  # @return [Bool]
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:86
  def success?; end

  # Coerce to a hash
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:176
  def to_h; end

  # Return values wrapper with the input processed by schema
  #
  # @return [Values]
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:62
  def values; end

  private

  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:217
  def initialize_errors(options = T.unsafe(nil)); end

  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/result.rb:222
  def schema_errors(options); end

  class << self
    # Build a new result
    #
    # @param [Dry::Schema::Result] schema_result
    #
    # @api private
    #
    # pkg:gem/dry-validation#lib/dry/validation/result.rb:20
    def new(schema_result, context = T.unsafe(nil), options = T.unsafe(nil)); end
  end
end

# Rules capture configuration and evaluator blocks
#
# When a rule is applied, it creates an `Evaluator` using schema result and its
# block will be evaluated in the context of the evaluator.
#
# @see Contract#rule
#
# @api public
#
# pkg:gem/dry-validation#lib/dry/validation/rule.rb:15
class Dry::Validation::Rule < ::Dry::Validation::Function
  include ::Dry::Core::Equalizer::Methods

  # pkg:gem/dry-validation#lib/dry/validation/rule.rb:128
  def add_macro_from_hash(macros, spec); end

  # Evaluate the rule within the provided context
  #
  # @param [Contract] contract
  # @param [Result] result
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/rule.rb:34
  def call(contract, result); end

  # Define a validation function for each element of an array
  #
  # The function will be applied only if schema checks passed
  # for a given array item.
  #
  # @example
  #   rule(:nums).each do |index:|
  #     key([:number, index]).failure("must be greater than 0") if value < 0
  #   end
  #   rule(:nums).each(min: 3)
  #   rule(address: :city) do
  #      key.failure("oops") if value != 'Munich'
  #   end
  #
  # @return [Rule]
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/rule.rb:78
  def each(*macros, &block); end

  # Return a nice string representation
  #
  # @return [String]
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/rule.rb:108
  def inspect; end

  # Parse function arguments into macros structure
  #
  # @return [Array]
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/rule.rb:117
  def parse_macros(*args); end

  # Define which macros should be executed
  #
  # @see Contract#rule
  # @return [Rule]
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/rule.rb:53
  def validate(*macros, &block); end
end

# Error raised during initialization of a contract that has no schema defined
#
# pkg:gem/dry-validation#lib/dry/validation/constants.rb:36
class Dry::Validation::SchemaMissingError < ::StandardError
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/constants.rb:38
  def initialize(klass); end
end

# A convenient wrapper for data processed by schemas
#
# Values are available within the rule blocks. They act as hash-like
# objects and expose a convenient API for accessing data.
#
# @api public
#
# pkg:gem/dry-validation#lib/dry/validation/values.rb:14
class Dry::Validation::Values
  include ::Enumerable
  include ::Dry::Core::Equalizer::Methods

  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/values.rb:26
  def initialize(data); end

  # Read from the provided key
  #
  # @example
  #   rule(:age) do
  #     key.failure('must be > 18') if values[:age] <= 18
  #   end
  #
  # @param args [Symbol, String, Hash, Array<Symbol>] If given as a single
  #   Symbol, String, Array or Hash, build a key array using
  #   {Dry::Schema::Path} digging for data. If given as positional
  #   arguments, use these with Hash#dig on the data directly.
  #
  # @return [Object]
  #
  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/values.rb:45
  def [](*args); end

  # Schema's result output
  #
  # @return [Hash]
  #
  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/values.rb:23
  def data; end

  # @api public
  #
  # pkg:gem/dry-validation#lib/dry/validation/values.rb:64
  def key?(key, hash = T.unsafe(nil)); end

  private

  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/values.rb:90
  def method_missing(meth, *, **, &); end

  # @api private
  #
  # pkg:gem/dry-validation#lib/dry/validation/values.rb:83
  def respond_to_missing?(meth, include_private = T.unsafe(nil)); end
end

# Wraps {AMQ::Protocol::Basic::GetOk} to
# provide access to the delivery properties as immutable hash as
# well as methods. Hash representation is created lazily.
#
# pkg:gem/bunny#lib/bunny/get_response.rb:7
class Bunny::GetResponse
  include ::Enumerable

  # @private
  #
  # pkg:gem/bunny#lib/bunny/get_response.rb:23
  def initialize(get_ok, channel); end

  # Accesses delivery properties by key
  # @see Hash#[]
  #
  # pkg:gem/bunny#lib/bunny/get_response.rb:36
  def [](k); end

  # @return [Bunny::Channel] Channel this basic.get-ok response is on
  #
  # pkg:gem/bunny#lib/bunny/get_response.rb:20
  def channel; end

  # @return [String] Delivery identifier that is used to acknowledge, reject and nack deliveries
  #
  # pkg:gem/bunny#lib/bunny/get_response.rb:69
  def delivery_tag; end

  # Iterates over the delivery properties
  # @see Enumerable#each
  #
  # pkg:gem/bunny#lib/bunny/get_response.rb:30
  def each(*args, &block); end

  # @return [String] Name of the exchange this message was published to
  #
  # pkg:gem/bunny#lib/bunny/get_response.rb:80
  def exchange; end

  # @private
  #
  # pkg:gem/bunny#lib/bunny/get_response.rb:64
  def inspect; end

  # @return [Boolean] true if this delivery is a redelivery (the message was requeued at least once)
  #
  # pkg:gem/bunny#lib/bunny/get_response.rb:74
  def redelivered; end

  # pkg:gem/bunny#lib/bunny/get_response.rb:77
  def redelivered?; end

  # @return [String] Routing key this message was published with
  #
  # pkg:gem/bunny#lib/bunny/get_response.rb:85
  def routing_key; end

  # @return [Hash] Hash representation of this delivery info
  #
  # pkg:gem/bunny#lib/bunny/get_response.rb:48
  def to_hash; end

  # @private
  #
  # pkg:gem/bunny#lib/bunny/get_response.rb:59
  def to_s; end
end


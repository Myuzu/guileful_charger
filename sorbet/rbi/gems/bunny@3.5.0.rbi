# Wraps basic properties hash as returned by amq-protocol to
# provide access to the delivery properties as immutable hash as
# well as methods.
#
# pkg:gem/bunny#lib/bunny/message_properties.rb:7
class Bunny::MessageProperties
  include ::Enumerable

  # @private
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:20
  def initialize(properties); end

  # Accesses message properties by key
  # @see Hash#[]
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:32
  def [](k); end

  # @return [String] Publishing application, as set by the publisher
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:112
  def app_id; end

  # @return [String] Cluster ID, as set by the publisher
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:117
  def cluster_id; end

  # @return [String] (Optional) content encoding of the message, as set by the publisher
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:57
  def content_encoding; end

  # @return [String] (Optional) content type of the message, as set by the publisher
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:52
  def content_type; end

  # @return [String] What message this message is a reply to (or corresponds to), as set by the publisher
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:77
  def correlation_id; end

  # @return [Integer] Delivery mode (persistent or transient)
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:67
  def delivery_mode; end

  # Iterates over the message properties
  # @see Enumerable#each
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:26
  def each(*args, &block); end

  # @return [String] Message expiration, as set by the publisher
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:87
  def expiration; end

  # @return [String] Message headers
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:62
  def headers; end

  # @private
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:47
  def inspect; end

  # @return [String] Message ID, as set by the publisher
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:92
  def message_id; end

  # @return [Integer] Message priority, as set by the publisher
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:72
  def priority; end

  # @return [String] (Optional) How to reply to the publisher (usually a reply queue name)
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:82
  def reply_to; end

  # @return [Time] Message timestamp, as set by the publisher
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:97
  def timestamp; end

  # @return [Hash] Hash representation of this delivery info
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:37
  def to_hash; end

  # @private
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:42
  def to_s; end

  # @return [String] Message type, as set by the publisher
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:102
  def type; end

  # @return [String] Publishing user, as set by the publisher
  #
  # pkg:gem/bunny#lib/bunny/message_properties.rb:107
  def user_id; end
end


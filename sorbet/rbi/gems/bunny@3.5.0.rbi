# Wraps AMQ::Protocol::Basic::Return to
# provide access to the return properties as immutable hash as
# well as methods. Hash representation is created lazily.
#
# pkg:gem/bunny#lib/bunny/return_info.rb:7
class Bunny::ReturnInfo
  include ::Enumerable

  # API
  #
  # pkg:gem/bunny#lib/bunny/return_info.rb:19
  def initialize(basic_return); end

  # Accesses returned delivery properties by key
  # @see Hash#[]
  #
  # pkg:gem/bunny#lib/bunny/return_info.rb:31
  def [](k); end

  # Iterates over the returned delivery properties
  # @see Enumerable#each
  #
  # pkg:gem/bunny#lib/bunny/return_info.rb:25
  def each(*args, &block); end

  # @return [String] Exchange the message was published to
  #
  # pkg:gem/bunny#lib/bunny/return_info.rb:72
  def exchange; end

  # @private
  #
  # pkg:gem/bunny#lib/bunny/return_info.rb:57
  def inspect; end

  # @return [Integer] Reply (status) code of the cause
  #
  # pkg:gem/bunny#lib/bunny/return_info.rb:62
  def reply_code; end

  # @return [Integer] Reply (status) text of the cause, explaining why the message was returned
  #
  # pkg:gem/bunny#lib/bunny/return_info.rb:67
  def reply_text; end

  # @return [String] Routing key the message has
  #
  # pkg:gem/bunny#lib/bunny/return_info.rb:77
  def routing_key; end

  # @return [Hash] Hash representation of this returned delivery info
  #
  # pkg:gem/bunny#lib/bunny/return_info.rb:42
  def to_hash; end

  # @private
  #
  # pkg:gem/bunny#lib/bunny/return_info.rb:52
  def to_s; end
end

# TLS-enabled TCP socket that implements convenience
# methods found in Bunny::Socket.
#
# pkg:gem/bunny#lib/bunny/cruby/ssl_socket.rb:11
class Bunny::SSLSocket < ::OpenSSL::SSL::SSLSocket
  # pkg:gem/bunny#lib/bunny/cruby/ssl_socket.rb:18
  def initialize(*args); end

  # Reads given number of bytes with an optional timeout
  #
  # @param [Integer] count How many bytes to read
  # @param [Integer] timeout Timeout
  #
  # @return [String] Data read from the socket
  # @api public
  #
  # pkg:gem/bunny#lib/bunny/cruby/ssl_socket.rb:30
  def read_fully(count, timeout = T.unsafe(nil)); end

  # Reads given number of bytes into an existing buffer with an optional timeout
  #
  # @param [String] buffer Buffer to read into (will be appended to)
  # @param [Integer] count How many bytes to read
  # @param [Integer] timeout Timeout
  #
  # @return [String] The buffer with data appended
  # @api public
  #
  # pkg:gem/bunny#lib/bunny/cruby/ssl_socket.rb:69
  def read_fully_into(buffer, count, timeout = T.unsafe(nil)); end

  # Writes provided data using IO#write_nonblock, taking care of handling
  # of exceptions it raises when writing would fail (e.g. due to socket buffer
  # being full).
  #
  # IMPORTANT: this method will mutate (slice) the argument. Pass in duplicates
  # if this is not appropriate in your case.
  #
  # @param [String] data Data to write
  # @param [Integer] timeout Timeout
  #
  # @api public
  #
  # pkg:gem/bunny#lib/bunny/cruby/ssl_socket.rb:113
  def write_nonblock_fully(data, timeout = T.unsafe(nil)); end
end

# pkg:gem/bunny#lib/bunny/cruby/ssl_socket.rb:13
Bunny::SSLSocket::READ_RETRY_EXCEPTION_CLASSES = T.let(T.unsafe(nil), Array)

# pkg:gem/bunny#lib/bunny/cruby/ssl_socket.rb:15
Bunny::SSLSocket::WRITE_RETRY_EXCEPTION_CLASSES = T.let(T.unsafe(nil), Array)

# An alias for the standard SSLSocket,
# exists from the days of JRuby support.
#
# pkg:gem/bunny#lib/bunny/ssl_socket.rb:8
Bunny::SSLSocketImpl = Bunny::SSLSocket


# Signal-handling class.
#
# Currently, the signal USR2 performs a thread dump,
# while QUIT, TERM and INT all perform a graceful shutdown.
#
# pkg:gem/hutch#lib/hutch/waiter.rb:8
class Hutch::Waiter
  include ::Hutch::Logging

  # pkg:gem/hutch#lib/hutch/waiter.rb:62
  def handle_shutdown_signal(sig); end

  # pkg:gem/hutch#lib/hutch/waiter.rb:44
  def handle_signal(sig); end

  # @raise ContinueProcessingSignals
  #
  # pkg:gem/hutch#lib/hutch/waiter.rb:54
  def handle_user_signal(sig); end

  # pkg:gem/hutch#lib/hutch/waiter.rb:29
  def wait_until_signaled; end

  private

  # pkg:gem/hutch#lib/hutch/waiter.rb:76
  def backtrace_for(thread); end

  # pkg:gem/hutch#lib/hutch/waiter.rb:68
  def log_thread_backtraces; end

  # pkg:gem/hutch#lib/hutch/waiter.rb:90
  def register_signal_handlers; end

  # pkg:gem/hutch#lib/hutch/waiter.rb:84
  def sig_read; end

  # pkg:gem/hutch#lib/hutch/waiter.rb:84
  def sig_read=(_arg0); end

  # pkg:gem/hutch#lib/hutch/waiter.rb:84
  def sig_write; end

  # pkg:gem/hutch#lib/hutch/waiter.rb:84
  def sig_write=(_arg0); end

  # pkg:gem/hutch#lib/hutch/waiter.rb:100
  def user_signal?(sig); end

  # pkg:gem/hutch#lib/hutch/waiter.rb:86
  def wait_for_signal; end

  class << self
    # pkg:gem/hutch#lib/hutch/waiter.rb:14
    def supported_signals_of(list); end

    # pkg:gem/hutch#lib/hutch/waiter.rb:25
    def wait_until_signaled; end
  end
end

# pkg:gem/hutch#lib/hutch/waiter.rb:11
class Hutch::Waiter::ContinueProcessingSignals < ::RuntimeError; end


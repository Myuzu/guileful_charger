# Include this module in a class to register it as a consumer. Consumers
# gain a class method called `consume`, which should be used to register
# the routing keys a consumer is interested in.
#
# pkg:gem/hutch#lib/hutch/consumer.rb:7
module Hutch::Consumer
  mixes_in_class_methods ::Hutch::Consumer::ClassMethods

  # pkg:gem/hutch#lib/hutch/consumer.rb:8
  def broker; end

  # pkg:gem/hutch#lib/hutch/consumer.rb:8
  def broker=(_arg0); end

  # pkg:gem/hutch#lib/hutch/consumer.rb:8
  def delivery_info; end

  # pkg:gem/hutch#lib/hutch/consumer.rb:8
  def delivery_info=(_arg0); end

  # pkg:gem/hutch#lib/hutch/consumer.rb:29
  def logger; end

  # pkg:gem/hutch#lib/hutch/consumer.rb:25
  def message_rejected?; end

  # pkg:gem/hutch#lib/hutch/consumer.rb:15
  def reject!; end

  # pkg:gem/hutch#lib/hutch/consumer.rb:20
  def requeue!; end

  class << self
    # pkg:gem/hutch#lib/hutch/consumer.rb:10
    def included(base); end
  end
end

# pkg:gem/hutch#lib/hutch/consumer.rb:33
module Hutch::Consumer::ClassMethods
  # Configures an optional argument that will be passed when declaring the queue.
  # Prefer using a policy to this DSL: https://www.rabbitmq.com/parameters.html#policies
  #
  # pkg:gem/hutch#lib/hutch/consumer.rb:79
  def arguments(arguments = T.unsafe(nil)); end

  # Explicitly set the queue type to 'classic'
  #
  # pkg:gem/hutch#lib/hutch/consumer.rb:65
  def classic_queue; end

  # Add one or more routing keys to the set of routing keys the consumer
  # wants to subscribe to.
  #
  # pkg:gem/hutch#lib/hutch/consumer.rb:36
  def consume(*routing_keys); end

  # Returns consumer custom arguments.
  #
  # pkg:gem/hutch#lib/hutch/consumer.rb:104
  def get_arguments; end

  # pkg:gem/hutch#lib/hutch/consumer.rb:114
  def get_options; end

  # The RabbitMQ queue name for the consumer. This is derived from the
  # fully-qualified class name. Module separators are replaced with single
  # colons, camelcased class names are converted to snake case.
  #
  # pkg:gem/hutch#lib/hutch/consumer.rb:96
  def get_queue_name; end

  # pkg:gem/hutch#lib/hutch/consumer.rb:128
  def get_serializer; end

  # pkg:gem/hutch#lib/hutch/consumer.rb:43
  def initial_group_size; end

  # Explicitly set the queue mode to 'lazy'
  #
  # pkg:gem/hutch#lib/hutch/consumer.rb:60
  def lazy_queue; end

  # pkg:gem/hutch#lib/hutch/consumer.rb:43
  def queue_mode; end

  # Explicitly set the queue name
  #
  # pkg:gem/hutch#lib/hutch/consumer.rb:46
  def queue_name(name); end

  # Configures queue options that will be passed when declaring the queue.
  #
  # pkg:gem/hutch#lib/hutch/consumer.rb:84
  def queue_options(options = T.unsafe(nil)); end

  # pkg:gem/hutch#lib/hutch/consumer.rb:43
  def queue_type; end

  # Explicitly set the queue type to 'quorum'
  # @param [Hash] options the options params related to quorum queue
  # @option options [Integer] :initial_group_size Initial Replication Factor
  #
  # pkg:gem/hutch#lib/hutch/consumer.rb:72
  def quorum_queue(options = T.unsafe(nil)); end

  # Accessor for the consumer's routing key.
  #
  # pkg:gem/hutch#lib/hutch/consumer.rb:124
  def routing_keys; end

  # Set custom serializer class, override global value
  #
  # pkg:gem/hutch#lib/hutch/consumer.rb:89
  def serializer(name); end

  # Opt out of the namespace prefix for this consumer's queue
  #
  # pkg:gem/hutch#lib/hutch/consumer.rb:51
  def without_namespace; end

  # pkg:gem/hutch#lib/hutch/consumer.rb:55
  def without_namespace?; end
end


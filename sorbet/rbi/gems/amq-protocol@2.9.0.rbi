class AMQ::Protocol::TableValueDecoder
  include ::AMQ::Protocol::TypeConstants

  class << self
    # pkg:gem/amq-protocol#lib/amq/protocol/table_value_decoder.rb:147
    def decode_32bit_float(data, offset); end

    # pkg:gem/amq-protocol#lib/amq/protocol/table_value_decoder.rb:155

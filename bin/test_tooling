#!/usr/bin/env ruby
ENV["BUNDLE_GEMFILE"] ||= File.expand_path("../Gemfile", __dir__)
require "bundler/setup"
require "coverage"
require "rspec/core"
require "rspec/mocks"
require "rspec/expectations"
require "json"
require "open3"
require "yaml"
require "fileutils"
require "tmpdir"
require "dry-types"
require "sorbet-runtime"
if ARGV.first == "compiler"
  require "tapioca/internal"
  require_relative "../config/initializers/dry"
  require_relative "../app/services/rebilling/types"
end
owns_coverage = !Coverage.running?
Coverage.start(lines: true) if owns_coverage
require_relative "../script/test_coverage_runner"
exit TestCoverageRunner.run(ARGV, owns_coverage: owns_coverage)
